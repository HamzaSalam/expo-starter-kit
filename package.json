{
  "name": "expo-starter-kit",
  "version": "1.0.0",
  "description": "A clean, modern starter template for Expo with Expo Router, NativeWind (Tailwind CSS), TypeScript, and ESLint.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@types/react": "~19.3.0",
    "eslint": "^9.21.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "expo",
    "expo-router",
    "react-native",
    "nativewind",
    "tailwindcss",
    "typescript",
    "starter",
    "template"
  ],
  "author": "",
  "license": "MIT"
}
